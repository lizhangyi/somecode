{
  "name": "code-knowledge-base",
  "private": true,
  "version": "1.0.0",
  "description": "个人代码知识库，记录工作中遇到的问题和解决方案",
  "scripts": {
    "install:json-editor": "cd projects/json-editor/vue_project && npm install",
    "install:snake-game": "cd projects/snake-game && npm install",
    "install:wujie": "cd projects/wujie-demo && pnpm install",
    "install:all": "npm-run-all --parallel install:*",
    "dev:json-editor": "cd projects/json-editor/vue_project && npm run dev",
    "dev:snake-game": "cd projects/snake-game && npm run dev",
    "dev:wujie": "cd projects/wujie-demo && pnpm run dev",
    "serve:static": "npx vite preview --port 8080 --base ./",
    "lint": "npm-run-all --parallel lint:*",
    "build": "npm-run-all --parallel build:*"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
